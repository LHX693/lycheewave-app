{
  "name": "lycheewave",
  "productName": "LycheeWave",
  "version": "0.3.1",
  "description": "LycheeWave — local speech-to-text & meeting notes (zh-CN / en / ja)",
  "main": "out/main.js",
  "license": "MIT",
  "author": "Miumiu Paw",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "pack:mac": "npm run build && electron-builder --mac dir --arm64",
    "test": "node scripts/test.mjs",
    "pack:mac:x64": "npm run build && electron-builder --mac dir --x64",
    "pack:win": "npm run build && electron-builder --win dir zip --x64"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "electron": "^43.8.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "app.lycheewave.desktop",
    "productName": "LycheeWave",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/bin",
        "to": "bin"
      },
      {
        "from": "vendor/models",
        "to": "models"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "LycheeWave uses the microphone to record your voice and turn it into text.",
        "NSAppleEventsUsageDescription": "LycheeWave controls “System Events” to paste transcribed text into the current app.",
        "NSScreenCaptureUsageDescription": "LycheeWave records system audio for meeting notes.",
        "LSUIElement": false,
        "NSCameraUsageDescription": "LycheeWave does not use the camera.",
        "NSBluetoothAlwaysUsageDescription": "LycheeWave does not use Bluetooth.",
        "NSBluetoothPeripheralUsageDescription": "LycheeWave does not use Bluetooth.",
        "NSAudioCaptureUsageDescription": "LycheeWave records system audio for meeting notes.",
        "CFBundleDevelopmentRegion": "en",
        "CFBundleAllowMixedLocalizations": true
      },
      "extraResources": [
        {
          "from": "assets/lproj",
          "to": ".",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "asar": true,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "LycheeWave-${version}-win-x64.${ext}",
      "signAndEditExecutable": false
    }
  }
}
